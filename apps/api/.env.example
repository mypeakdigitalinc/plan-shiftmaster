# Local: postgres from `pnpm db:reset` (or Supabase: the pooler connection string, port 6543)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/shifthub
PORT=8787
# Auth — use ONE of these.
# Local dev / Supabase legacy JWT secret:
AUTH_JWT_SECRET=local-dev-secret-change-me-at-least-32-chars
# Supabase signing keys: https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
# AUTH_JWKS_URL=
# AUTH_ISSUER=https://<project-ref>.supabase.co/auth/v1
AUTH_AUDIENCE=authenticated
CORS_ORIGINS=http://localhost:3000,http://localhost:8081
APP_URL=http://localhost:3000
