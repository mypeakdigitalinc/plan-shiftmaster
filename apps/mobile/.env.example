# Use your machine's LAN IP when testing on a physical phone, e.g. http://192.168.1.20:8787
# (and add the Expo origin to the API's CORS_ORIGINS for web, e.g. http://localhost:8081)
EXPO_PUBLIC_API_URL=http://localhost:8787
# "dev" = email-only login via the API's /dev/token (local only). "supabase" for real auth.
EXPO_PUBLIC_AUTH_MODE=dev
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=
